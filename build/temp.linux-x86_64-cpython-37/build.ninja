ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.1/bin/nvcc

cflags = -pthread -B /home/winky/enter/envs/benchmark/compiler_compat -Wl,--sysroot=/ -Wsign-compare -DNDEBUG -g -fwrapv -O3 -Wall -Wstrict-prototypes -fPIC -DWITH_CUDA -I/mnt/d/axylin/code/benchmark/kaihuatang/Scene-Graph-Benchmark.pytorch/maskrcnn_benchmark/csrc -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/torch/csrc/api/include -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/TH -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/THC -I/usr/local/cuda-11.1/include -I/home/winky/enter/envs/benchmark/include/python3.7m -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -DWITH_CUDA -I/mnt/d/axylin/code/benchmark/kaihuatang/Scene-Graph-Benchmark.pytorch/maskrcnn_benchmark/csrc -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/torch/csrc/api/include -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/TH -I/home/winky/enter/envs/benchmark/lib/python3.7/site-packages/torch/include/THC -I/usr/local/cuda-11.1/include -I/home/winky/enter/envs/benchmark/include/python3.7m -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



